# make run needs no .env.docker or inference API key: it runs Apertus locally.
# Accept the model access conditions and run hf auth login on the host first.
# Optional overrides: copy to .env.docker, or export variables in the shell.
# Do not put credentials in this example or commit .env.docker.
# These three settings are used only by make run-remote / run-remote-gpu.
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=
LLM_API_KEY=
APP_PORT=8000
DECISION_PROVIDER=kev
# All helper services are local. No SiliconFlow, Mixedbread or TypeSafe keys needed.
TYPESAFE_API_KEY=
HELPER_THREADS=4
KEV_DTYPE=fp32
WIKI_AUTO_SYNTHESIS=true

# Local GPU mode is the default. Downloads automatically reuse the host login.
# HF_TOKEN can override that login and is used only by the download container.
# HF_TOKEN=
# HOST_HF_HOME=/path/to/host/huggingface
# LOCAL_LLM_IMAGE=ghcr.io/swiss-ai/vllm_apertus_1.5_release@sha256:d85533f251c8272218ae2e519510836376e5a335b44f2204f193018e37753bc6
# LOCAL_LLM_NAME=swiss-ai/Apertus-v1.5-8B
# LOCAL_MODEL_REVISION=ef4bbc54d6fe658bc782280ff9f3b53a10a9758f
# LOCAL_MAX_MODEL_LEN=16384
# LOCAL_GPU_MEMORY_UTILIZATION=0.85
